{
  "manifest_version": 3,
  "name": "PhishGuard",
  "version": "1.1.0",
  "description": "Flags phishing emails and suspicious links in Gmail using rule-based scoring.",
  "permissions": ["storage", "scripting"],
  "host_permissions": ["https://mail.google.com/*", "https://*.execute-api.amazonaws.com/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["scoring.js", "logo.js", "panel.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "PhishGuard",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
